{
  "name": "tiktok-attendance",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "build:bundle": "node scripts/generate-embedded-assets.js && esbuild src/server.js --bundle --platform=node --target=node22 --format=cjs --outfile=dist/app.cjs",
    "build:exe": "npm run build:bundle && npx -y @yao-pkg/pkg dist/app.cjs -c package.json --targets node22-win-x64 --output bin/tiktok-attendance.exe && node -e \"if(fs.existsSync('public')) fs.cpSync('public', 'bin/public', {recursive: true})\"",
    "postinstall": "node scripts/patch-tiktok.js"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "open": "^11.0.2",
    "socket.io": "^4.8.3",
    "tiktok-live-connector": "^2.4.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
